{
  "version": "agent_council_config_v1",
  "status": "default_seed",
  "authority": {
    "principle": "many intelligences deliberate; WIS decides",
    "canonical_write_path": "proposal_ratification",
    "agent_can_ratify": false,
    "agent_can_commit_canon": false,
    "preserve_dissent": true
  },
  "llm_policy": {
    "provider": "codex_cli",
    "command": "codex",
    "model_selection": "runtime_default",
    "external_review_provider": "gemini_ai_studio",
    "secret_material_allowed_in_config": false,
    "default_reasoning_effort": "high",
    "fallback_reasoning_effort": "medium",
    "temperature_policy": "role_default",
    "output_contract": "agent_council_packet_v1"
  },
  "providers": {
    "codex_cli": {
      "enabled": true,
      "command": "codex",
      "model_selection": "runtime_default",
      "secret_material_allowed_in_config": false
    },
    "gemini_ai_studio": {
      "enabled": false,
      "role": "external_reviewer",
      "api_key_env": "GEMINI_API_KEY",
      "model_env": "GEMINI_REVIEW_MODEL",
      "default_model": "gemini-3.1-flash-lite",
      "max_chars_env": "GEMINI_REVIEW_MAX_CHARS",
      "default_max_chars": 12000,
      "allowed_use": "non_sensitive_review_only",
      "sensitivity_gate": "explicit_allowlist",
      "required_sensitivity_label": "non_sensitive",
      "secret_material_allowed_in_config": false,
      "free_tier_content_policy": "may_be_used_to_improve_provider_products"
    }
  },
  "orchestrator": {
    "session_key_prefix": "agent-council",
    "default_target_kind": "task",
    "evidence_budget": {
      "max_files_to_inspect": 24,
      "max_external_sources": 1,
      "require_source_refs_for_canonical_claims": true
    },
    "external_review": {
      "enabled_by_default": false,
      "provider": "gemini_ai_studio",
      "requires_api_key_env": "GEMINI_API_KEY",
      "requires_operator_enable_env": "GEMINI_EXTERNAL_REVIEW_ENABLED",
      "requires_sensitivity_label": "non_sensitive",
      "blocked_without_explicit_label": true,
      "send_only_sanitized_briefs": true,
      "send_raw_diffs": false,
      "send_secret_material": false
    },
    "synthesis_rules": [
      "show_recommended_path_first",
      "show_strongest_objection_second",
      "keep_minority_reports_addressable",
      "convert_weak_evidence_to_probe_request",
      "create_separate_proposal_candidates_for_competing_changes"
    ]
  },
  "agents": [
    {
      "id": "architect",
      "llm_profile": "frontier_reasoning",
      "stance_bias": "system_shape",
      "freedoms": ["reframe_goal", "propose_interfaces", "challenge_coupling"],
      "limits": ["no_canonical_write", "no_ratification"]
    },
    {
      "id": "implementer",
      "llm_profile": "frontier_reasoning",
      "stance_bias": "smallest_viable_change",
      "freedoms": ["suggest_patch_plan", "identify_tests", "name_migration_path"],
      "limits": ["no_unreviewed_feature_expansion", "no_canonical_write"]
    },
    {
      "id": "critic",
      "llm_profile": "critical_review",
      "stance_bias": "failure_modes",
      "freedoms": ["object", "counterexample", "request_evidence"],
      "limits": ["must_provide_actionable_objection", "no_ratification"]
    },
    {
      "id": "operator_advocate",
      "llm_profile": "operator_clarity",
      "stance_bias": "human_decision_quality",
      "freedoms": ["simplify_decision", "surface_tradeoffs", "ask_minimum_question"],
      "limits": ["no_hidden_consensus", "no_canonical_write"]
    },
    {
      "id": "risk_auditor",
      "llm_profile": "critical_review",
      "stance_bias": "auth_data_governance",
      "freedoms": ["classify_risk", "block_on_missing_guardrail", "request_audit_evidence"],
      "limits": ["no_secret_exposure", "no_ratification"]
    },
    {
      "id": "historian",
      "llm_profile": "context_grounded",
      "stance_bias": "canon_and_branch_memory",
      "freedoms": ["cite_prior_decisions", "detect_stale_context", "compare_backlog"],
      "limits": ["must_mark_uncertain_memory", "no_canonical_write"]
    },
    {
      "id": "wildcard",
      "llm_profile": "creative_probe",
      "stance_bias": "non_obvious_alternatives",
      "freedoms": ["speculate_with_label", "propose_experiment", "challenge_premise"],
      "limits": ["must_label_speculation", "no_ratification"]
    },
    {
      "id": "external_reviewer",
      "llm_profile": "gemini_external_review",
      "stance_bias": "independent_non_sensitive_review",
      "freedoms": ["object", "counterexample", "request_evidence", "compare_public_assumptions"],
      "limits": [
        "non_sensitive_review_only",
        "requires_sanitized_brief",
        "no_raw_diff_review",
        "no_secret_exposure",
        "no_canonical_write",
        "no_ratification"
      ]
    }
  ],
  "llm_profiles": {
    "frontier_reasoning": {
      "provider": "codex_cli",
      "model": "runtime_default",
      "reasoning_effort": "high"
    },
    "critical_review": {
      "provider": "codex_cli",
      "model": "runtime_default",
      "reasoning_effort": "high"
    },
    "operator_clarity": {
      "provider": "codex_cli",
      "model": "runtime_default",
      "reasoning_effort": "medium"
    },
    "context_grounded": {
      "provider": "codex_cli",
      "model": "runtime_default",
      "reasoning_effort": "medium"
    },
    "creative_probe": {
      "provider": "codex_cli",
      "model": "runtime_default",
      "reasoning_effort": "medium"
    },
    "gemini_external_review": {
      "provider": "gemini_ai_studio",
      "model": "gemini-3.1-flash-lite",
      "model_env": "GEMINI_REVIEW_MODEL",
      "reasoning_effort": "medium",
      "sensitivity_gate": "explicit_allowlist",
      "required_sensitivity_label": "non_sensitive"
    }
  }
}
