# Remote readiness template (sin secretos reales)
# Copiar a .env.remote y completar con valores reales fuera de Git.

# Cloudflare named tunnel
CF_NAMED_TUNNEL_TOKEN="<CLOUDFLARE_NAMED_TUNNEL_TOKEN>"
CF_MCP_PUBLIC_BASE_URL="https://mcp.example.com"

# Header de autenticacion MCP (defaults canonicos)
MCP_AUTH_HEADER_NAME="Authorization"
MCP_AUTH_SCHEME="Bearer"

# Modo simple (un solo token para read/write)
MCP_AUTH_TOKEN="<JWT_WITH_REQUIRED_SCOPES>"

# Modo recomendado (tokens separados por plano)
MCP_AUTH_TOKEN_READ="<JWT_READ_SCOPES>"
MCP_AUTH_TOKEN_WRITE="<JWT_WRITE_SCOPES>"

# Token para validar claims (opcional: fallback a token read/simple)
MCP_OAUTH_CLAIMS_TOKEN="<JWT_FOR_CLAIMS_VALIDATION>"

# Validacion estricta de claims OAuth/Auth0
AUTH0_EXPECTED_ISS="https://tenant.auth0.com/"
AUTH0_EXPECTED_AUD="https://wis-context-sync-api"
AUTH0_REQUIRED_SCOPES_READ="openid profile email mcp.read"
AUTH0_REQUIRED_SCOPES_WRITE="openid profile email mcp.write"

# Opcional: payload registry custom para validate_remote_mcp
MCP_TOOL_PAYLOAD_REGISTRY_PATH="scripts/mcp_validation_payloads.json"

# Nota: validate_remote_mcp.sh y validate_remote_mcp_write.sh leen
# POSTGRES_USER y POSTGRES_DB desde .env (archivo local del repo).
