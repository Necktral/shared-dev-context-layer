# ============================================================
# Shared Dev Context Layer — configuracion LOCAL / personal
# Sin Auth0, sin tunel, sin conector. MCP en localhost sin auth.
# Copia este archivo a .env  ->  cp .env.example .env
# El .env NO se sube a git (ver .gitignore).
# ============================================================

# --- Postgres (docker-compose) ---
POSTGRES_DB=wis_context
POSTGRES_USER=wis_admin
POSTGRES_PASSWORD=wis_local_dev_change_me
POSTGRES_HOST_PORT=5432

# --- Puertos backend / MCP (compose los exige) ---
BACKEND_PORT=8001
MCP_PORT=8002

# --- App ---
PROJECT_NAME=shared-dev-context-layer
SYSTEM_MODE=delegated_limited
DATABASE_URL=postgresql://wis_admin:wis_local_dev_change_me@postgres:5432/wis_context

# --- MCP: AUTENTICACION DESACTIVADA (uso local) ---
# Con bypass_local=true no se requiere Auth0/JWT/tunel y todas las tools
# quedan accesibles en localhost sin token.
MCP_AUTH_ENABLED=false
MCP_AUTH_BYPASS_LOCAL=true
MCP_ALLOWED_ORIGINS=

# --- Observabilidad (opcional) ---
MCP_LOG_LEVEL=INFO
MCP_LOG_JSON=true
MCP_LOG_PAYLOADS=false

# ============================================================
# OPCIONAL — solo si algun dia expones el MCP a internet con Auth0.
# Pon MCP_AUTH_ENABLED=true y MCP_AUTH_BYPASS_LOCAL=false, y rellena:
# MCP_AUTH0_ISSUER=https://<tenant>.auth0.com/
# MCP_AUTH0_AUDIENCE=https://<your-mcp-audience>
# MCP_AUTH0_JWKS_URL=https://<tenant>.auth0.com/.well-known/jwks.json
# MCP_PUBLIC_BASE_URL=https://<dominio-estable>
# MCP_ALLOWED_ORIGINS=https://chatgpt.com
# ============================================================
