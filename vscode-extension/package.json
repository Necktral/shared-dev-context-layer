{
  "name": "wis-context-sync-control-plane",
  "displayName": "WIS Context Sync",
  "description": "Authenticated control plane for WIS Context Sync with dual runtime (offline_fixture/mcp).",
  "version": "0.2.0-internal",
  "publisher": "necktral",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:wisContextSync.localRuntimePanel",
    "onCommand:wisContextSync.loadOperationalContext",
    "onCommand:wisContextSync.resetSession",
    "onCommand:wisContextSync.prepareHandoff",
    "onCommand:wisContextSync.configureAuthentication",
    "onCommand:wisContextSync.clearAuthentication",
    "onCommand:wisContextSync.searchContext",
    "onCommand:wisContextSync.upsertContextItem",
    "onCommand:wisContextSync.appendContextEvent",
    "onCommand:wisContextSync.linkContextEntities",
    "onCommand:wisContextSync.setContextLabels",
    "onCommand:wisContextSync.archiveContextItem",
    "onCommand:wisContextSync.applySyncBatch",
    "onCommand:wisContextSync.localIndex",
    "onCommand:wisContextSync.localPrepareTask",
    "onCommand:wisContextSync.localRunCodex",
    "onCommand:wisContextSync.localRefresh",
    "onCommand:wisContextSync.localConfigureDbPassword"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "wisContextSync.localRuntimePanel",
          "name": "WIS Local Runtime"
        }
      ]
    },
    "commands": [
      {
        "command": "wisContextSync.loadOperationalContext",
        "title": "WIS: Load Operational Context"
      },
      {
        "command": "wisContextSync.resetSession",
        "title": "WIS: Reset Session"
      },
      {
        "command": "wisContextSync.prepareHandoff",
        "title": "WIS: Prepare Handoff"
      },
      {
        "command": "wisContextSync.configureAuthentication",
        "title": "WIS: Configure Authentication"
      },
      {
        "command": "wisContextSync.clearAuthentication",
        "title": "WIS: Clear Authentication"
      },
      {
        "command": "wisContextSync.searchContext",
        "title": "WIS: Search Context"
      },
      {
        "command": "wisContextSync.upsertContextItem",
        "title": "WIS: Upsert Context Item"
      },
      {
        "command": "wisContextSync.appendContextEvent",
        "title": "WIS: Append Context Event"
      },
      {
        "command": "wisContextSync.linkContextEntities",
        "title": "WIS: Link Context Entities"
      },
      {
        "command": "wisContextSync.setContextLabels",
        "title": "WIS: Set Context Labels"
      },
      {
        "command": "wisContextSync.archiveContextItem",
        "title": "WIS: Archive Context Item"
      },
      {
        "command": "wisContextSync.applySyncBatch",
        "title": "WIS: Apply Sync Batch"
      },
      {
        "command": "wisContextSync.localIndex",
        "title": "WIS: Local Index"
      },
      {
        "command": "wisContextSync.localPrepareTask",
        "title": "WIS: Local Prepare Task"
      },
      {
        "command": "wisContextSync.localRunCodex",
        "title": "WIS: Local Run Codex"
      },
      {
        "command": "wisContextSync.localRefresh",
        "title": "WIS: Local Refresh"
      },
      {
        "command": "wisContextSync.localConfigureDbPassword",
        "title": "WIS: Local Configure DB Password"
      }
    ],
    "configuration": {
      "title": "WIS Context Sync",
      "properties": {
        "wisContextSync.mcpEndpoint": {
          "type": "string",
          "default": "http://localhost:8002/mcp",
          "markdownDescription": "MCP endpoint used by the extension control plane."
        },
        "wisContextSync.diagnosticMode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enables detailed diagnostics output in the WIS Context Sync channel."
        },
        "wisContextSync.runtimeMode": {
          "type": "string",
          "enum": [
            "mcp",
            "offline_fixture"
          ],
          "default": "offline_fixture",
          "markdownDescription": "Explicit runtime mode. Use 'mcp' for live MCP transport or 'offline_fixture' for deterministic fixture mode."
        },
        "wisContextSync.requestTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "markdownDescription": "Per-tool MCP request timeout in milliseconds."
        },
        "wisContextSync.fixtureScenario": {
          "type": "string",
          "enum": [
            "success_full",
            "partial_missing_recent_errors",
            "degraded_no_remote_bundle",
            "transport_error",
            "no_active_task",
            "validation_stale"
          ],
          "default": "success_full",
          "markdownDescription": "Deterministic scenario used when runtimeMode is offline_fixture."
        },
        "wisContextSync.authMode": {
          "type": "string",
          "enum": [
            "none",
            "bearer",
            "api_key"
          ],
          "default": "none",
          "markdownDescription": "Authentication mode for MCP transport. Token is stored in VS Code SecretStorage via command."
        },
        "wisContextSync.authHeaderName": {
          "type": "string",
          "default": "x-api-key",
          "markdownDescription": "Header name used when authMode is api_key."
        },
        "wisContextSync.requireAuthentication": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "If true and authMode != none, load is blocked when token is missing."
        },
        "wisContextSync.operationProfile": {
          "type": "string",
          "enum": [
            "phase3_control_plane",
            "local_private"
          ],
          "default": "phase3_control_plane",
          "markdownDescription": "Operational profile selector. Use local_private to enable local Codex baseline commands."
        },
        "wisContextSync.codexCliCommand": {
          "type": "string",
          "default": "codex",
          "markdownDescription": "CLI command used by local Codex runner (package 1 baseline)."
        },
        "wisContextSync.localDb.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable PostgreSQL persistence for local_private profile."
        },
        "wisContextSync.localDb.host": {
          "type": "string",
          "default": "localhost",
          "markdownDescription": "PostgreSQL host for local_private profile."
        },
        "wisContextSync.localDb.port": {
          "type": "number",
          "default": 5432,
          "minimum": 1,
          "markdownDescription": "PostgreSQL port for local_private profile."
        },
        "wisContextSync.localDb.database": {
          "type": "string",
          "default": "wis_context",
          "markdownDescription": "PostgreSQL database name for local_private profile."
        },
        "wisContextSync.localDb.user": {
          "type": "string",
          "default": "wis_admin",
          "markdownDescription": "PostgreSQL username for local_private profile."
        },
        "wisContextSync.localDb.password": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional plaintext PostgreSQL password. If empty, SecretStorage key wisContextSync.localDbPassword is used."
        },
        "wisContextSync.localDb.schema": {
          "type": "string",
          "default": "local_private",
          "markdownDescription": "Schema namespace used by local_private persistence."
        },
        "wisContextSync.localDb.ssl": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable SSL when connecting to PostgreSQL for local_private profile."
        },
        "wisContextSync.localIndex.excludeDirs": {
          "type": "array",
          "default": [
            ".git",
            "node_modules",
            "dist",
            "build",
            ".next",
            "coverage",
            ".turbo",
            ".cache",
            "out",
            "tmp",
            "vendor"
          ],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Directory names excluded by local incremental indexer."
        },
        "wisContextSync.localIndex.includeExtensions": {
          "type": "array",
          "default": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx",
            ".mjs",
            ".cjs",
            ".json",
            ".yml",
            ".yaml",
            ".md",
            ".mdx",
            ".txt",
            ".py",
            ".go",
            ".rs",
            ".java",
            ".kt",
            ".sql",
            ".sh",
            ".toml",
            ".ini",
            ".cfg",
            ".env",
            ".css",
            ".scss",
            ".html",
            ".xml"
          ],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Allowed file extensions for local incremental indexer."
        },
        "wisContextSync.localIndex.maxFileBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 1024,
          "markdownDescription": "Maximum file size in bytes indexed by local indexer."
        },
        "wisContextSync.localIndex.chunkSizeChars": {
          "type": "number",
          "default": 1200,
          "minimum": 100,
          "markdownDescription": "Chunk size in characters for file_chunks generation."
        },
        "wisContextSync.localIndex.chunkOverlapChars": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "markdownDescription": "Chunk overlap in characters for file_chunks generation."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test \"dist/tests/**/*.test.js\"",
    "test:local-db": "LOCAL_DB_TESTS=1 npm run compile && LOCAL_DB_TESTS=1 node --test \"dist/tests/local-db/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/pg": "^8.20.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.16.3"
  }
}
